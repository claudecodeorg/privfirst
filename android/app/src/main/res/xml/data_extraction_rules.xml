<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup / device-transfer rules. Excludes everything: localStorage (which
     backs the Encrypted Notes vault, favourites and the billing trial-start timestamp) must never
     leave this device via Google's backup or a device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
